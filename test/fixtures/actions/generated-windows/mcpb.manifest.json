{
  "manifest_version": "0.1",
  "name": "OuroShop.Mcp",
  "version": "1.0.0",
  "description": "Ouro UI actions for shopping, generated from their declarations.",
  "author": {
    "name": "Ouro"
  },
  "server": {
    "type": "binary",
    "entry_point": "OuroShop.Mcp.exe",
    "mcp_config": {
      "command": "OuroShop.Mcp.exe",
      "args": []
    }
  },
  "tools": [
    {
      "name": "get_shopping_list",
      "description": "Read the person's shopping list: each item's id, name, quantity, unit and whether it is checked."
    },
    {
      "name": "add_shopping_list_item",
      "description": "Add one item to the person's shopping list. Give the name as the person said it; leave quantity and unit out when they gave none."
    },
    {
      "name": "remove_shopping_list_item",
      "description": "Remove one item from the person's shopping list by its id. Removing an item that is already gone changes nothing."
    },
    {
      "name": "share_shopping_list",
      "description": "Share the person's shopping list with another person, who can then see and change it."
    }
  ],
  "tools_generated": false,
  "license": "MIT",
  "_meta": {
    "com.microsoft.windows": {
      "static_responses": {
        "initialize": {
          "protocolVersion": "2025-06-18",
          "capabilities": {
            "tools": {
              "listChanged": false
            }
          },
          "serverInfo": {
            "name": "OuroShop.Mcp",
            "version": "1.0.0"
          }
        },
        "tools/list": {
          "tools": [
            {
              "name": "get_shopping_list",
              "title": "Shopping list",
              "description": "Read the person's shopping list: each item's id, name, quantity, unit and whether it is checked.",
              "inputSchema": {
                "type": "object",
                "properties": {
                  "show": {
                    "type": "string",
                    "description": "Which items to list; all of them when left out.",
                    "enum": [
                      "all",
                      "unchecked"
                    ]
                  }
                },
                "required": [],
                "additionalProperties": false
              },
              "annotations": {
                "readOnlyHint": true,
                "destructiveHint": false,
                "openWorldHint": false
              },
              "outputSchema": {
                "type": "object",
                "properties": {
                  "items": {
                    "type": "string",
                    "description": "The list's items, as JSON."
                  }
                },
                "required": [
                  "items"
                ],
                "additionalProperties": false
              }
            },
            {
              "name": "add_shopping_list_item",
              "title": "Add to list",
              "description": "Add one item to the person's shopping list. Give the name as the person said it; leave quantity and unit out when they gave none.",
              "inputSchema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "What to buy, as the person said it, such as \"oat milk\"."
                  },
                  "quantity": {
                    "type": "number",
                    "description": "How many or how much.",
                    "minimum": 0
                  },
                  "unit": {
                    "type": "string",
                    "description": "The unit of the quantity, such as g, cups or cans."
                  },
                  "idempotencyKey": {
                    "type": "string",
                    "description": "Send the same key again when retrying this exact call, and the item is added once."
                  }
                },
                "required": [
                  "name"
                ],
                "additionalProperties": false
              },
              "annotations": {
                "readOnlyHint": false,
                "destructiveHint": false,
                "openWorldHint": false
              },
              "outputSchema": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "The new item's id."
                  },
                  "name": {
                    "type": "string",
                    "description": "The item's name as stored."
                  }
                },
                "required": [
                  "id",
                  "name"
                ],
                "additionalProperties": false
              }
            },
            {
              "name": "remove_shopping_list_item",
              "title": "Remove",
              "description": "Remove one item from the person's shopping list by its id. Removing an item that is already gone changes nothing.",
              "inputSchema": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "The item's id, from get_shopping_list."
                  },
                  "alsoIds": {
                    "type": "array",
                    "description": "More item ids to remove in the same call.",
                    "items": {
                      "type": "string",
                      "description": "An item's id."
                    }
                  }
                },
                "required": [
                  "id"
                ],
                "additionalProperties": false
              },
              "annotations": {
                "readOnlyHint": false,
                "destructiveHint": true,
                "openWorldHint": false,
                "idempotentHint": true
              }
            },
            {
              "name": "share_shopping_list",
              "title": "Share list",
              "description": "Share the person's shopping list with another person, who can then see and change it.",
              "inputSchema": {
                "type": "object",
                "properties": {
                  "with": {
                    "type": "string",
                    "description": "The email address of the person to share with."
                  },
                  "canEdit": {
                    "type": "boolean",
                    "description": "Whether they may change the list, not only see it."
                  },
                  "message": {
                    "type": "string",
                    "description": "A note to send with the invitation. It may run over several lines."
                  }
                },
                "required": [
                  "with"
                ],
                "additionalProperties": false
              },
              "annotations": {
                "readOnlyHint": false,
                "destructiveHint": true,
                "openWorldHint": true
              }
            }
          ]
        }
      }
    }
  }
}
