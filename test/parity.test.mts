// tokens:parity must catch a one-byte change. Runs after `pnpm tokens` (CI runs it in that order).
import assert from "node:assert/strict";
import { execFileSync, spawnSync } from "node:child_process";
import { cpSync, mkdtempSync, readFileSync, writeFileSync } from "node:fs";
import { tmpdir } from "node:os";
import { join } from "node:path";
import { test } from "node:test";

const repo = new URL("../", import.meta.url).pathname;

test("parity fails when one generated byte changes", () => {
  execFileSync("node", ["scripts/build.mts"], { cwd: repo });
  const dist = mkdtempSync(join(tmpdir(), "ouro-parity-"));
  cpSync(join(repo, "dist"), dist, { recursive: true });
  const file = join(dist, "web/ouro-theme.css");
  const bytes = readFileSync(file);
  const at = bytes.indexOf("#0066cc");
  bytes[at + 1] = "1".charCodeAt(0); // #0066cc -> #1066cc
  writeFileSync(file, bytes);
  const run = spawnSync("node", ["scripts/parity.mts", "--dist", dist], { cwd: repo, encoding: "utf8" });
  assert.equal(run.status, 1, run.stdout + run.stderr);
  assert.match(run.stdout, new RegExp(`FAIL  dist/web/ouro-theme.css differs from .* at byte ${at + 1} `));
  assert.match(run.stdout, /9\/10 files byte-identical/);
});
