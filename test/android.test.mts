import assert from "node:assert/strict";
import { test } from "node:test";
import { renderApple } from "../src/apple.mts";
import { ANDROID_COLORS, composeSpring, kotlinName, renderAndroid } from "../src/android.mts";
import { THEMES } from "../src/tokens.mts";

/** Each theme's block of a generated file: from `<theme> = OuroTheme(` to the next theme or the end. */
function themeBlocks(text: string, start: (t: string) => RegExp): Map<string, string> {
  const out = new Map<string, string>();
  for (const t of THEMES) {
    const m = start(t).exec(text);
    assert.ok(m, `no ${t} theme`);
    const rest = text.slice(m.index);
    const next = THEMES.map((o) => (o === t ? -1 : rest.search(start(o)))).filter((i) => i > 0);
    out.set(t, rest.slice(0, next.length ? Math.min(...next) : undefined));
  }
  return out;
}

const modes = (block: string) => {
  const light = block.indexOf("light");
  const dark = block.indexOf("dark");
  return { light: block.slice(light, dark), dark: block.slice(dark) };
};

/** Android's sRGB colour as 0xAARRGGBB, or null when it is written in Display P3. */
function kotlinArgb(mode: string, name: string): string | null {
  const m = new RegExp(`\\b${name} = Color\\(([^\\n]*?)\\)(?: /\\*[^\\n]*\\*/)?,\\n`).exec(mode);
  assert.ok(m, `Android has no ${name}`);
  const hex = /^0x([0-9A-F]{8})$/.exec(m[1]!);
  return hex ? hex[1]! : null;
}

/** Apple's sRGB colour as AARRGGBB, rounded to 8 bits, or null when it is written in Display P3. */
function swiftArgb(mode: string, name: string): string | null {
  const m = new RegExp(`\\b${name}: Color\\((\\.\\w+), red: ([\\d.]+), green: ([\\d.]+), blue: ([\\d.]+), opacity: ([\\d.]+)\\)`).exec(mode);
  assert.ok(m, `Apple has no ${name}`);
  if (m[1] !== ".sRGB") return null;
  const byte = (x: string) => Math.round(Number(x) * 255).toString(16).padStart(2, "0").toUpperCase();
  return `${byte(m[5]!)}${byte(m[2]!)}${byte(m[3]!)}${byte(m[4]!)}`;
}

test("every Android colour is Apple's colour, in every theme and mode", async () => {
  const kotlin = themeBlocks(await renderAndroid("test"), (t) => new RegExp(`val ${t} = OuroTheme\\(`));
  const swift = themeBlocks(await renderApple("test"), (t) => new RegExp(`static let ${t} = OuroTheme\\(`));
  let compared = 0;
  for (const theme of THEMES) {
    const k = modes(kotlin.get(theme)!);
    const s = modes(swift.get(theme)!.split("extras:")[0]!);
    for (const mode of ["light", "dark"] as const) {
      for (const c of ANDROID_COLORS) {
        const name = kotlinName(c);
        const a = kotlinArgb(k[mode], name);
        const b = swiftArgb(s[mode], name);
        assert.equal(a === null, b === null, `${theme} ${mode} ${c}: one platform writes it in Display P3 and the other doesn't`);
        // Apple writes four decimals, so its 8-bit value can sit one step from the hex Android writes.
        if (a !== null) for (let i = 0; i < 8; i += 2) assert.ok(Math.abs(parseInt(a.slice(i, i + 2), 16) - parseInt(b!.slice(i, i + 2), 16)) <= 1, `${theme} ${mode} ${c}: Android ${a}, Apple ${b}`);
        compared++;
      }
    }
  }
  assert.equal(compared, THEMES.length * 2 * ANDROID_COLORS.length);
});

test("motion is Apple's motion, in milliseconds", async () => {
  const kotlin = await renderAndroid("test");
  const swift = await renderApple("test");
  for (const d of ["fast", "base", "slow", "press", "sheet", "draw"]) {
    const s = new RegExp(`static let ${d}: Double = ([\\d.]+)`).exec(swift);
    const k = new RegExp(`const val ${d}: Int = (\\d+)`).exec(kotlin);
    assert.ok(s && k, `duration ${d}`);
    assert.equal(Number(k[1]), Math.round(Number(s[1]) * 1000), `duration ${d}`);
  }
  assert.match(kotlin, /const val scale: Float = 0\.\d+f/);
  assert.match(kotlin, /val out = CubicBezierEasing\(/);
});

test("the spring is critically damped at no bounce, and stiffer when quicker", () => {
  assert.equal(composeSpring(0.5, 0).dampingRatio, 1);
  assert.equal(composeSpring(0.5, 0.2).dampingRatio, 0.8);
  assert.ok(composeSpring(0.25, 0).stiffness > composeSpring(0.5, 0).stiffness);
  assert.equal(Math.round(composeSpring(1, 0).stiffness * 1000) / 1000, Math.round(4 * Math.PI * Math.PI * 1000) / 1000);
});

test("the file names its version and every theme", async () => {
  const kotlin = await renderAndroid("v9.9.9");
  assert.match(kotlin, /^\/\/ OuroTokens\.kt/);
  assert.match(kotlin, /Generated by ourostack\/ouro-ui-core v9\.9\.9/);
  assert.match(kotlin, /^package bot\.ouro\.ui\.hx\.tokens$/m);
  for (const t of THEMES) assert.match(kotlin, new RegExp(`OuroThemeName\\.${t[0]!.toUpperCase()}${t.slice(1)} -> ${t}`));
  assert.match(kotlin, /val pearl = OuroTheme\([\s\S]*?radius = \d+(\.\d+)?\.dp,\n {4}\)/);
});
