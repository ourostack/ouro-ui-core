// Ouro HX for Android: renders dist/android/OuroTokens.kt, Kotlin for Jetpack Compose that needs only
// androidx.compose.ui and androidx.compose.animation.core. Colours are resolved here, as for Apple (aliases, modes
// and color-mix() included), because Compose has no var(). The CSS has light and dark values and no high-contrast
// ones, so neither does this file; ouro-ui-android derives high contrast the way ouro-ui-apple does.
// An oklch() colour outside sRGB is written in Display P3, as browsers draw it on wide-gamut screens.
// A theme's own extras (Cookbook's sj-* tokens) reach Apple only for now; Android takes them when an app needs them.
import { dtcgToRgba, oklchToDisplayP3, rgbaToHex } from "./color.mts";
import type { DtcgColor } from "./css-value.mts";
import { APPLE_COLORS, swiftName } from "./apple.mts";
import { layered, resolve, THEMES, type Resolved } from "./tokens.mts";

/** The colours each theme carries on Android: the same names as Apple's. */
export const ANDROID_COLORS = APPLE_COLORS;

/** dp per rem: Android's text and the web's default root font size agree on 16 at the default scale. */
const DP_PER_REM = 16;

export const kotlinName = swiftName;
const enumCase = (theme: string) => theme.charAt(0).toUpperCase() + theme.slice(1);

/** A Kotlin Float literal with at most four decimals. */
export const kfloat = (x: number) => {
  const s = (Math.round(x * 10000) / 10000).toFixed(4).replace(/0+$/, "").replace(/\.$/, ".0");
  return `${s === "-0.0" ? "0.0" : s}f`;
};

/** A colour as Compose writes it: 0xAARRGGBB in sRGB, or Display P3 floats when it is outside sRGB. */
export function kotlinColor(value: unknown, where: string): string {
  const c = value as DtcgColor;
  if (!c || typeof c !== "object" || !("colorSpace" in c)) throw new Error(`${where} is not a colour`);
  const rgba = dtcgToRgba(c);
  const p3 = c.colorSpace === "oklch" ? oklchToDisplayP3(...(c.components.map((x) => (x === "none" ? 0 : x)) as [number, number, number])) : null;
  if (p3) return `Color(${kfloat(p3[0])}, ${kfloat(p3[1])}, ${kfloat(p3[2])}, ${kfloat(rgba.a)}, ColorSpaces.DisplayP3) /* oklch(${c.components.join(" ")}), outside sRGB; ${rgbaToHex(rgba)} clipped */`;
  const hex = rgbaToHex({ ...rgba, a: 1 }).slice(1).toUpperCase();
  const alpha = Math.round(rgba.a * 255).toString(16).padStart(2, "0").toUpperCase();
  return `Color(0x${alpha}${hex})`;
}

function millis(value: unknown, where: string): number {
  const d = value as { value: number; unit: string };
  if (d?.unit === "ms") return Math.round(d.value);
  if (d?.unit === "s") return Math.round(d.value * 1000);
  throw new Error(`${where} is not a duration`);
}

function dp(value: unknown, where: string): number {
  const d = value as { value: number; unit: string };
  if (d?.unit === "rem") return d.value * DP_PER_REM;
  if (d?.unit === "px") return d.value;
  throw new Error(`${where} is not a dimension`);
}

const get = (map: Map<string, Resolved>, id: string, where: string) => {
  const r = map.get(id);
  if (!r) throw new Error(`${where}: no token ${id}`);
  return r;
};

/**
 * The CSS spring (a visual duration and a bounce, as SwiftUI's `.spring(duration:bounce:)` takes them) as Compose's
 * `spring(dampingRatio, stiffness)`: stiffness (2π / duration)², damping ratio 1 − bounce for a bounce of 0 or more.
 */
export function composeSpring(visualDurationSeconds: number, bounce: number): { dampingRatio: number; stiffness: number } {
  const omega = (2 * Math.PI) / visualDurationSeconds;
  return { dampingRatio: bounce >= 0 ? 1 - bounce : 1 / (1 + bounce), stiffness: omega * omega };
}

export async function renderAndroid(version: string): Promise<string> {
  const base = await resolve(await layered());
  const raw = await layered();
  const doc = (id: string, indent: string) => (raw.get(id)?.$description ? `${indent}/** ${raw.get(id)!.$description} */\n` : "");
  const durations = ["fast", "base", "slow", "press", "sheet", "draw"];
  const eases = [...raw.keys()].filter((id) => id.startsWith("ouro.ease.") && raw.get(id)!.$type === "cubicBezier");
  const seconds = (id: string) => millis(get(base, id, "Spring").light, id) / 1000;
  const spring = composeSpring(seconds("ouro.spring.visual-duration"), get(base, "ouro.spring.bounce", "Spring").light as number);
  const out: string[] = [];
  out.push(`// OuroTokens.kt — Ouro HX tokens for Android (Jetpack Compose).
// Generated by ourostack/ouro-ui-core ${version} from tokens/*.tokens.json (DTCG 2025.10).
// Don't edit; change the tokens and run \`pnpm tokens\`. MIT License.
package bot.ouro.ui.hx.tokens

import androidx.compose.animation.core.CubicBezierEasing
import androidx.compose.runtime.Immutable
import androidx.compose.ui.graphics.Color
import androidx.compose.ui.graphics.colorspace.ColorSpaces
import androidx.compose.ui.unit.Dp
import androidx.compose.ui.unit.dp

/** The themes Ouro HX ships, as on https://ui.ouroboros.bot/. */
enum class OuroThemeName(val id: String) {
${THEMES.map((t) => `    ${enumCase(t)}("${t}"),`).join("\n")}
}

/** One colour mode's colours. The names are Ouro HX's CSS variables in camel case: \`--primary-foreground\` is \`primaryForeground\`. */
@Immutable
data class OuroColors(
${ANDROID_COLORS.map((c) => `    val ${kotlinName(c)}: Color,`).join("\n")}
)

/** A theme: its colours in light and dark mode, and its corner radius. */
@Immutable
data class OuroTheme(
    val name: OuroThemeName,
    val light: OuroColors,
    val dark: OuroColors,
    /** The base corner radius (CSS \`--radius\` at ${DP_PER_REM} dp per rem). */
    val radius: Dp,
) {
    /** The colours for dark or light mode, such as \`isSystemInDarkTheme()\`. */
    fun colors(dark: Boolean): OuroColors = if (dark) this.dark else light
}

/** Ouro HX's tokens: motion, and every theme's colours. */
object OuroTokens {
    /** The theme ui.ouroboros.bot opens on. */
    val defaultTheme: OuroThemeName = OuroThemeName.Pearl

    /** Durations in milliseconds. */
    object Duration {`);
  for (const d of durations) out.push(`${doc(`ouro.duration.${d}`, "        ")}        const val ${d}: Int = ${millis(get(base, `ouro.duration.${d}`, "Duration").light, d)}`);
  out.push(`    }

    /** Easing curves. */
    object Ease {`);
  for (const id of eases) {
    const [x1, y1, x2, y2] = get(base, id, "Ease").light as number[];
    out.push(`${doc(id, "        ")}        val ${kotlinName(id.slice("ouro.ease.".length))} = CubicBezierEasing(${kfloat(x1!)}, ${kfloat(y1!)}, ${kfloat(x2!)}, ${kfloat(y2!)})`);
  }
  out.push(`    }

    /** The spring Ouro HX moves with, as Compose's \`spring(dampingRatio, stiffness)\` takes it. */
    object Spring {
        /** The CSS spring's full settle time in milliseconds (\`--ouro-spring-duration\`). */
        const val durationMillis: Int = ${millis(get(base, "ouro.spring.duration", "Spring").light, "spring.duration")}
${doc("ouro.spring.visual-duration", "        ")}        const val visualDurationMillis: Int = ${millis(get(base, "ouro.spring.visual-duration", "Spring").light, "spring.visual-duration")}
${doc("ouro.spring.bounce", "        ")}        const val bounce: Float = ${kfloat(get(base, "ouro.spring.bounce", "Spring").light as number)}
        /** 1 − bounce. */
        const val dampingRatio: Float = ${kfloat(spring.dampingRatio)}
        /** (2π / visual duration)², with the duration in seconds. */
        const val stiffness: Float = ${kfloat(spring.stiffness)}
    }

    /** Press feedback. */
    object Press {
        /** The scale a control shrinks to while pressed. */
        const val scale: Float = ${kfloat(get(base, "ouro.press.scale", "Press").light as number)}
    }

    /** A theme by name. */
    fun theme(name: OuroThemeName): OuroTheme = when (name) {
${THEMES.map((t) => `        OuroThemeName.${enumCase(t)} -> ${t}`).join("\n")}
    }
`);
  for (const theme of THEMES) {
    const tokens = await resolve(await layered(theme));
    const colors = (mode: "light" | "dark") =>
      `OuroColors(\n${ANDROID_COLORS.map((c) => `            ${kotlinName(c)} = ${kotlinColor(get(tokens, c, theme)[mode], `${theme} ${c} (${mode})`)},`).join("\n")}\n        )`;
    const radius = dp(get(tokens, "radius", theme).light, `${theme} radius`);
    out.push(`    val ${theme} = OuroTheme(
        name = OuroThemeName.${enumCase(theme)},
        light = ${colors("light")},
        dark = ${colors("dark")},
        radius = ${kfloat(radius).slice(0, -1)}.dp,
    )
`);
  }
  out.push("}\n");
  return out.join("\n");
}
