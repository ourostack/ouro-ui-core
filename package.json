{
  "name": "@ouro.bot/ui-core",
  "version": "0.7.2",
  "private": true,
  "description": "The platform-neutral core of Ouro UI: one token source that every platform builds from.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.2.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "tokens": "node scripts/build.mts",
    "tokens:parity": "node scripts/parity.mts",
    "tokens:import": "node scripts/import-from-web.mts",
    "apple:check": "sh scripts/apple-check.sh",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'test/**/*.test.mts' 'scripts/*.test.mjs'",
    "hx:page": "node scripts/hx-page.mts",
    "feel:page": "node scripts/feel-page.mts",
    "actions:generate": "node src/actions.mts generate test/fixtures/actions/shopping.actions.mts test/fixtures/actions/generated",
    "actions:check": "node src/actions.mts check test/fixtures/actions/shopping.actions.mts test/fixtures/actions/generated",
    "actions:page": "node scripts/actions-page.mts",
    "a2ui:generate": "node scripts/a2ui-conformance.mts",
    "a2ui:check": "node scripts/a2ui-conformance.mts --check"
  },
  "devDependencies": {
    "@terrazzo/parser": "2.10.0",
    "@types/node": "24.19.2",
    "ajv": "8.17.1",
    "typescript": "5.9.3"
  }
}
